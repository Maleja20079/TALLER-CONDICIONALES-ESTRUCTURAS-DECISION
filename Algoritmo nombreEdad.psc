Algoritmo nombreEdad
	definir nombre como cadena
	definir edad como real
	
	escribir "DIGITE SU NOMBRE"
	leer nombre
	escribir "DIGITE SU EDAD"
	leer edad
	
	si edad >= 18 Entonces
		escribir nombre, " eres mayor de edad"
		
	SiNo
		
		escribir nombre, " eres menor de edad"
		
	FinSi
	
FinAlgoritmo
