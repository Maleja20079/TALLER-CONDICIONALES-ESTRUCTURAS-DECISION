Algoritmo rango
	
	definir num1 Como Real
	
	escribir "Digite el número"
	leer num1
	
	si num1 > 3.5 y num1 <= 7.8 Entonces
		
		escribir "El número real está dentro del rango (3.5,7.8] "
		
	SiNo
		
		escribir "El número no se encuentra dentro del rango estipulado"
		
	FinSi
FinAlgoritmo
