Algoritmo rango
	
	definir num1 Como Real
	
	escribir "INGRESE UN NÚMERO"
	leer num1
	
	si num1>3.5 y num1<=7.8 o num1>4.5 y num1<=9.3 o num1>=23.4 y num1<=43.3 Entonces
		
		escribir "El número se encuentra en el rango estipulado"
		
	SiNo
		
		escribir "El número no se encuetra en el rango"
	FinSi
	
FinAlgoritmo
